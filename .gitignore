# Python
*.pyc
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/

# Coverage output. Not just build noise: .coverage records the absolute
# paths of the machine that produced it, so committing it would publish a
# local directory layout along with it.
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local-only test suite: fast unit tests that run against a minimal HA stub
# without installing Home Assistant (kept out of the repo). The committed
# CI test suite lives in /tests/ and runs against real Home Assistant on
# GitHub Actions (see .github/workflows/test.yaml).
/tests_local/

# Local-only CLI debug tool and its output (hits the real portal;
# developer utility, not shipped to end users). wem_dump/ can contain
# live session cookies and installation-specific values - never commit it.
wem_debug.py
wem_debug.txt
wem_dump/

# Local HA dev instance / scratch
/ha_config
# Anchored to the repo root. Unanchored, this pattern matches a directory
# named `scripts` at ANY depth - it silently swallowed .github/scripts/,
# so a workflow referring to a script there would have failed with a file
# that exists locally and was never committed.
/scripts/

# Build artifacts
*.zip
